{
  "name": "rummage-ui",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "gen:api": "openapi-typescript ${SPEC:-openapi.json} -o src/lib/api-types.ts",
    "mock": "bun mock/server.ts",
    "test": "playwright test",
    "size": "bun scripts/size.ts",
    "screenshots": "SCREENSHOTS=1 playwright test --project screenshots"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/bun": "^1.4.3",
    "openapi-typescript": "^7.13.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "~5.9",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@lucide/svelte": "^1.59.0"
  }
}
